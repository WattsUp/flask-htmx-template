<div>
  <h1>JSON API</h1>
</div>
<div class="mx-auto max-w-3xl px-2 pb-8">
  <p class="mb-6 text-on-surface-variant">
    Interactive documentation for the JSON API. All endpoints accept and return
    <code>application/json</code>. Expand a path to see examples and send live
    requests.
  </p>

  {% for group in groups %}
    <h2 class="mt-6 mb-3 font-serif text-xl text-primary">{{ group.name }}</h2>
    <div class="flex flex-col gap-2">
      {% for path in group.paths %}
        {% include "api/path.jinja" %}
      {% endfor %}
    </div>
  {% endfor %}
</div>
